# ── Core (required) ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/aurafit
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Admin seed account (required for `npm run seed:admin`) ─────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ── AI — Text (primary → fallback chain) ────────────────────────────────────
# Mistral is primary (free tier, ~1 req/sec). Get a key at console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Optional extra fallbacks — the app works with just Mistral
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── AI — Embeddings (semantic + visual search) ──────────────────────────────
# Free at huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=

# ── AI — Virtual Try-On ──────────────────────────────────────────────────────
# Optional — paid, fast. Free at replicate.com; without it (or with $0 credit)
# the app automatically falls back to a free Hugging Face Space (no key needed).
REPLICATE_API_KEY=

# ── Image hosting (profile pictures) ─────────────────────────────────────────
# Cloudinary Dashboard → Account Details has a ready-made CLOUDINARY_URL to copy.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Scraper tuning (all optional) ────────────────────────────────────────────
SCRAPER_DRY_RUN=false
SCRAPER_MAX_PER_BRAND=50
SCRAPER_DELAY_MS=1500
SCRAPER_RETRY_LIMIT=3
SCRAPER_CRON_SCHEDULE=0 3 * * 0
