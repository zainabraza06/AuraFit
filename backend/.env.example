# ── Core (required) ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/aurafit
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Admin seed account (required for `npm run seed:admin`) ─────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ── AI — Text (primary → fallback chain) ────────────────────────────────────
# Providers are tried in order (LLM_PROVIDER_ORDER, default: ollama,groq,gemini,openrouter). Any one key is enough.
# Check them with: npm run llm:selftest
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional local model for development: OLLAMA_URL=http://localhost:11434

# ── AI — Embeddings (semantic + visual search) ──────────────────────────────
# Free at huggingface.co/settings/tokens
# Only used by the virtual try-on Hugging Face Space fallback. Embeddings no longer need it:
# they run locally (Qwen3-Embedding-0.6B via transformers.js; first use downloads ~600 MB to backend/.model-cache).
HUGGING_FACE_API_KEY=

# ── AI — Virtual Try-On ──────────────────────────────────────────────────────
# Optional — paid, fast. Free at replicate.com; without it (or with $0 credit)
# the app automatically falls back to a free Hugging Face Space (no key needed).
REPLICATE_API_KEY=

# ── Image hosting (profile pictures) ─────────────────────────────────────────
# Cloudinary Dashboard → Account Details has a ready-made CLOUDINARY_URL to copy.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Scraper tuning (all optional) ────────────────────────────────────────────
SCRAPER_DRY_RUN=false
SCRAPER_MAX_PER_BRAND=50
SCRAPER_DELAY_MS=1500
SCRAPER_RETRY_LIMIT=3
# The weekly refresh runs in GitHub Actions (.github/workflows/weekly-refresh.yml). Only set this for a
# single-instance deployment that should scrape from inside the API process instead:
SCRAPER_CRON_ENABLED=false
SCRAPER_CRON_SCHEDULE=0 3 * * 0

# ── Event pipeline (optional) ───────────────────────────────────────────────
# Publish scraper events to Kafka. Off by default; a broker outage never aborts a scrape.
PIPELINE_ENABLED=false
KAFKA_BROKERS=localhost:9092
# Enables the API response cache and shared rate-limit counters. Unset = in-memory / no cache.
REDIS_URL=
