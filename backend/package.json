    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "replicate": "^1.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.6.7"
