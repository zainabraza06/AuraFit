{
  "name": "fashion-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "scrape": "node scripts/scrapers/index.js",
    "scrape:dry": "cross-env SCRAPER_DRY_RUN=true node scripts/scrapers/index.js",
    "scrape:shoes": "node scripts/scrapers/runVertical.js shoes",
    "scrape:watches": "node scripts/scrapers/runVertical.js watches",
    "scrape:jewelry": "node scripts/scrapers/runVertical.js jewelry",
    "scrape:all-verticals": "node scripts/scrapers/runVertical.js all",
    "scrape:test": "node scripts/testScraper.js",
    "scrape:khaadi-test": "node scripts/scrapers/testKhaadiFetch.js",
    "scrape:fresh": "node scripts/clearDB.js && node scripts/scrapers/index.js",
    "export:catalog": "node scripts/exportCatalog.js",
    "audit:catalog": "node scripts/auditCatalog.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "embed:clothing": "node scripts/embedAll.js",
    "embed:accessories": "node scripts/embedAccessories.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@gradio/client": "^2.3.1",
    "@huggingface/inference": "^4.13.15",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "replicate": "^1.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4"
  }
}
