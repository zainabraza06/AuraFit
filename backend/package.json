    "@huggingface/transformers": "^4.3.2",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
