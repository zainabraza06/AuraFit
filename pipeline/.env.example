# Kafka / RabbitMQ / Redis / Mongo endpoints (docker-compose overrides these)
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/aurafit_pipeline

# Optional: Cloudinary for the image worker (CLOUDINARY_URL=cloudinary://key:secret@cloud)
CLOUDINARY_URL=

METRICS_PORT=9100
LOG_LEVEL=info
